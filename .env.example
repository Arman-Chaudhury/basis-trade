ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=
ATTY_VOICE_ID=
DEMO_MODE=0
# Atropos Node service (venues, Atty, Jev, SnapTrade, 13F, news). Its own keys go in services/atropos/.env
ATROPOS_URL=http://127.0.0.1:4411
